# Committed to a public repository: never put a secret value here. The signing
# secret is read from Secrets Manager at runtime by the Amplify SSR compute role.
# Next.js loads this file in production, and it is how settings reach the server
# on Amplify, whose environment variables do not reach SSR code at runtime.
MCP_LOGIN_CLIENT_IP_SECRET_ID=rocket-feast/website/mcp-login-client-ip-secret
MCP_LOGIN_CLIENT_IP_SECRET_REGION=ap-southeast-2
